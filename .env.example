# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env.
APP_ENV=development

# Database (untuk Docker Compose host-nya "db"; jalan tanpa Docker pakai "localhost")
POSTGRES_USER=anterin
POSTGRES_PASSWORD=anterin
POSTGRES_DB=anterin_dong
DATABASE_URL=postgresql+psycopg2://anterin:anterin@db:5432/anterin_dong

# Auth: email + password (tanpa SSO/Google, keputusan D-013). Isi JWT_SECRET dengan string acak panjang.
JWT_SECRET=
JWT_ALGORITHM=HS256
# Tidak ada refresh token di MVP, jadi masa berlaku access token dibuat cukup panjang (8 jam).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Daftar origin frontend, dipisah koma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ALLOWED_EMAIL_DOMAIN=mail.ugm.ac.id
